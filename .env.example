# ================================================================
# SENTINEL AI - ENVIRONMENT CONFIGURATION (TEMPLATE)
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env locally.
# ================================================================

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=sentinel_ai_dev_secret_key_change_in_production_32bytes_min

# LLM Provider Configuration
# Supported: openai, anthropic, groq, mock (offline testing without api keys)
LLM_PROVIDER=mock
LLM_API_KEY=your_openai_or_groq_api_key_here
LLM_MODEL=gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=15
MAX_REQUEST_BYTES=32768

# Database & Privacy Audit
DATABASE_URL=sqlite:///./sentinel_audit.db
LOG_RAW_CONTENT=false
AUDIT_RETENTION_DAYS=90

# Gateway Security & Limits
RATE_LIMIT_PER_MINUTE=60
ENFORCE_STRICT_FAIL_CLOSED=true
DEFAULT_POLICY_VERSION=v1.0
